# ==============================================================================
# IGRID INNOVATION LAB - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Configure these environment variables in your cloud deployment dashboard
# (Render, Railway, Fly.io, etc.).
# ==============================================================================

# Server Port (Render & Railway inject PORT automatically)
PORT=3000

# Node Environment ('production' or 'development')
NODE_ENV=production

# JSON Web Token Secret (Provide a secure random string with 32+ characters)
JWT_SECRET=igrid_lab_super_secret_jwt_key_change_in_production_2026

# Administrator Credentials
ADMIN_EMAIL=admin@igridlab.edu.in
ADMIN_DEFAULT_PASSWORD=Admin@123

# Tunnel Configuration (Set to 'false' in cloud hosting)
ENABLE_NGROK=false
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# Database Directory (Defaults to './data' in repo root)
# If using a persistent cloud volume, set to your mount path e.g. /var/data
DATA_DIR=./data

# Optional: Claude AI Assistant API Key
ANTHROPIC_API_KEY=

# Optional: Google OAuth Client Configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
